# Optional free OpenChargeMap developer key; the default run uses OSM only.
# Copy this file to .env. Never commit your key.
# Register/check current terms at https://openchargemap.org/site/develop/api
OCM_API_KEY=

# Browser Maps JavaScript API key. Enable that API and billing in Google Cloud.
# Restrict the key to your application HTTP referrers and this API.
GOOGLE_MAPS_API_KEY=
